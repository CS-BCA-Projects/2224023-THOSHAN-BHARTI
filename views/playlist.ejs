<!DOCTYPE html>
<html lang="en" class="bg-green-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nature Vibes</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css" rel="stylesheet">
  <style>
    .fade-in { animation: fadeIn 1.2s ease-in-out; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    body::before {
      content: "";
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      animation: slideshow 40s infinite ease-in-out;
      z-index: -1; opacity: 0.9;
    }
    @keyframes slideshow {
      0%, 20% { background-image: url('https://images.unsplash.com/photo-1506748686214-e9df14d4d9d0?auto=format&fit=crop&w=1950&q=80'); }
      25%, 45% { background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1950&q=80'); }
      50%, 70% { background-image: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1950&q=80'); }
      75%, 95% { background-image: url('https://images.unsplash.com/photo-1496483648148-47c686dc86a8?auto=format&fit=crop&w=1950&q=80'); }
    }
    audio::-webkit-media-controls-panel { background-color: #f0fdf4; border-radius: 12px; }
  </style>
</head>

<body class="min-h-screen flex flex-col items-center bg-green-100 font-sans">
  <%- include('navbar') %>

  <!-- Earphone Popup -->
  <div id="popup" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-green-50 p-6 rounded-2xl shadow-2xl text-center max-w-sm w-full border border-green-200">
      <div class="text-4xl mb-4">🎧</div>
      <h3 class="text-xl font-semibold text-green-900 mb-2">For the Best Experience</h3>
      <p class="text-green-800 mb-4">Please use headphones to enjoy the full relaxing vibe 🌿</p>
      <button onclick="closePopup()" class="bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-full transition shadow-md">Got it!</button>
    </div>
  </div>

  <main class="container mx-auto px-4 py-10">
    <!-- Browse Button -->
    <div class="text-center mb-10">
      <a href="/browse" class="inline-block bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-6 rounded-full transition duration-300 shadow-lg">
        Browse Songs
      </a>
    </div>

    <!-- Playlist Cards -->
    <h2 class="text-3xl font-bold text-green-900 mb-6">Relaxing Playlists</h2>

    <div id="cardsContainer" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <% const staticSongs = [
        { title: "Energy", file: "/Songs/bright.mp3", image: "morning.jpg", id: "energy" },
        { title: "Calm Vibes", file: "/Songs/cheerful.mp3", image: "yoga.jpg", id: "calm" },
        { title: "Focus Music", file: "/Songs/focus.mp3", image: "piano.jpg", id: "focus" },
        { title: "Heartfelt Moments", file: "/Songs/heartfelt.mp3", image: "sea image.jpg", id: "heartfelt" },
        { title: "Peaceful Piano", file: "/Songs/peaceful.mp3", image: "piano.jpg", id: "peaceful" },
        { title: "Rain Sounds", file: "/Songs/rain.mp3", image: "rain.jpg", id: "rain" },
        { title: "Soothing Strings", file: "/Songs/soothing.mp3", image: "soothingstrings.jpg", id: "soothing" }
      ]; %>

      <% staticSongs.forEach(song => { %>
        <div class="card fade-in bg-white/80 rounded-xl shadow-lg p-4" data-title="<%= song.title %>" data-genre="<%= song.id %>">
          <img src="/images/<%= song.image %>" class="rounded-lg w-full h-40 object-cover mb-2" alt="<%= song.title %>"/>
          <h3 class="text-lg font-semibold text-green-800 text-center mb-2"><%= song.title %></h3>
          <audio controls class="w-full rounded-lg" onplay="logRecentlyPlayed('<%= song.title %>', '<%= song.id %>', '<%= song.file %>')">
            <source src="<%= song.file %>" type="audio/mpeg" />
          </audio>
          <div class="flex justify-center gap-2 mt-3">
            <button onclick="toggleFavorite(this, '<%= song.title %>', '<%= song.id %>', '<%= song.file %>')"
                    class="text-gray-500 hover:text-pink-600 bg-transparent border border-current px-3 py-1 rounded-full">
              🤍
            </button>
            <button onclick="addToLibrary('playlist', '<%= song.title %>', '<%= song.id %>', '<%= song.file %>')"
                    class="text-blue-600 hover:text-blue-800 bg-transparent border border-current px-3 py-1 rounded-full">
              ➕
            </button>
          </div>
        </div>
      <% }); %>

      <% if (typeof sounds !== 'undefined' && sounds.length > 0) { %>
        <% sounds.forEach(song => { %>
          <div class="card fade-in bg-white/80 rounded-xl shadow-lg p-4" data-title="<%= song.title %>" data-genre="<%= song.genre || 'dynamic' %>">
            <img src="<%= song.image %>" class="rounded-lg w-full h-40 object-cover mb-2" alt="<%= song.title %>"/>
            <h3 class="text-lg font-semibold text-green-800 text-center mb-2"><%= song.title %></h3>
            <audio controls class="w-full rounded-lg" onplay="logRecentlyPlayed('<%= song.title %>', '<%= song._id %>', '<%= song.file %>')">
              <source src="<%= song.file %>" type="audio/mpeg" />
            </audio>
            <div class="flex justify-center gap-2 mt-3">
              <button onclick="toggleFavorite(this, '<%= song.title %>', '<%= song._id %>', '<%= song.file %>')"
                      class="text-gray-500 hover:text-pink-600 bg-transparent border border-current px-3 py-1 rounded-full">
                🤍
              </button>
              <button onclick="addToLibrary('playlist', '<%= song.title %>', '<%= song._id %>', '<%= song.file %>')"
                      class="text-blue-600 hover:text-blue-800 bg-transparent border border-current px-3 py-1 rounded-full">
                ➕
              </button>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p class="text-center col-span-full text-green-700">No dynamic songs available.</p>
      <% } %>
    </div>
  </main>

  <!-- Favorite + History Logic -->
  <script>
    const favSet = new Set();

    function closePopup() {
      document.getElementById('popup').style.display = 'none';
    }

    function toggleFavorite(button, title, videoId, fileUrl) {
      console.log('Toggling Favorite:', title, videoId);
      const isFav = favSet.has(videoId);
      const type = isFav ? 'unfavorite' : 'favorite';

      fetch('/api/library/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, videoId, thumbnail: fileUrl, type })
      }).then(() => {
        console.log('Favorite toggled:', title, videoId);
        if (isFav) {
          favSet.delete(videoId);
          button.innerText = '🤍';
          button.classList.remove('text-pink-600');
          button.classList.add('text-gray-500');
        } else {
          favSet.add(videoId);
          button.innerText = '❤️';
          button.classList.remove('text-gray-500');
          button.classList.add('text-pink-600');
        }
      }).catch(err => console.error('Error toggling favorite:', err));
    }

    function logRecentlyPlayed(title, videoId, fileUrl) {
      console.log('Recently Played:', title, videoId);
      fetch('/api/library/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, videoId, thumbnail: fileUrl, type: 'history' })
      }).then(() => console.log('Logged Recently Played:', title, videoId))
        .catch(err => console.error('Error logging recently played:', err));
    }

    function addToLibrary(type, title, videoId, fileUrl) {
      console.log('Adding to Library:', type, title, videoId);
      fetch('/api/library/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, videoId, thumbnail: fileUrl, type })
      }).then(() => console.log('Added to Library:', type, title, videoId))
        .catch(err => console.error('Error adding to library:', err));
    }
  </script>

</body>
</html>
