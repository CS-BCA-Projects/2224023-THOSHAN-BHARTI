<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Nature Meditation</title>
  <link href="https://fonts.googleapis.com/css2?family=Comfortaa&family=Quicksand:wght@500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Quicksand', sans-serif;
      background: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?ixlib=rb-4.0.3&auto=format&fit=crop&w=1950&q=80') no-repeat center center fixed;
      background-size: cover;
      color: #fff;
      text-align: center;
      overflow-x: hidden;
      font-weight: 600;
    }

    h1 {
      margin-top: 2rem;
      font-size: 2.8rem;
      color: #192d02;
      text-shadow: 1px 1px 2px #000;
    }

    .breath-box {
      margin: 60px auto 30px;
      width: 180px;
      height: 180px;
      border-radius: 50%;
      background: radial-gradient(circle, #b2f2bb, #69db7c);
      animation: breathe 8s ease-in-out infinite;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      font-weight: 700;
      color: #1b5e20;
      box-shadow: 0 0 20px rgba(30, 100, 30, 0.3);
      z-index: 1;
      position: relative;
    }

    @keyframes breathe {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.25); }
    }

    .meditation-corner {
      margin: 30px auto;
      padding: 20px;
      width: 90%;
      max-width: 600px;
      background-color: rgba(14, 7, 7, 0.15);
      border-radius: 20px;
      box-shadow: 0 0 10px rgba(4, 44, 4, 0.2);
      z-index: 1;
      position: relative;
      font-weight: 600;
    }

    .quote {
      font-style: italic;
      margin: 30px auto;
      color: #e8f5e9;
      max-width: 600px;
      font-size: 1.2rem;
      z-index: 1;
      position: relative;
      text-shadow: 1px 1px 2px #000;
    }

    .tips {
      background-color: rgba(255, 255, 255, 0.2);
      padding: 20px;
      margin: 40px auto;
      max-width: 600px;
      border-radius: 15px;
      z-index: 1;
      position: relative;
      font-weight: 600;
    }

    .tips ul {
      list-style: none;
      padding-left: 0;
      color: #dcedc1;
      font-weight: 600;
    }

    footer {
      margin-top: 40px;
      padding: 20px;
      background-color: rgba(255, 255, 255, 0.15);
      color: #dcedc1;
      z-index: 1;
      position: relative;
      font-weight: 600;
    }

    button {
      margin-top: 15px;
      padding: 10px 20px;
      background-color: #a5d6a7;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      font-size: 1rem;
      color: #1b5e20;
      font-weight: bold;
      transition: background 0.3s;
    }

    button:hover {
      background-color: #81c784;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center bg-green-100 font-sans">

  <!-- Include updated navbar -->
  <%- include('navbar') %>

  <h1>Relax & Breathe</h1>

  <div class="breath-box">
    Inhale...<br>Exhale...
  </div>

  <div class="quote">
    "In the midst of nature, we find ourselves." – Anonymous
  </div>

  <div class="meditation-corner">
    <h2>Meditation Corner</h2>
    <p>Let this calming sound guide your breath and quiet your mind.</p>

    <!-- Hidden YouTube audio -->
    <iframe
      id="yt-audio"
      width="0"
      height="0"
      src="https://www.youtube.com/embed/cA494RXJBz4?enablejsapi=1&playlist=cA494RXJBz4&loop=1&controls=0&rel=0&modestbranding=1"
      frameborder="0"
      allow="autoplay"
      allowfullscreen
      style="display: none;">
    </iframe>

    <button onclick="playAudio()">▶ Play</button>
    <button onclick="pauseAudio()">⏸ Pause</button>
  </div>

  <div class="tips">
    <h3>🌼 Mindful Breathing Tips</h3>
    <ul>
      <li>🍃 Close your eyes and focus on your breath</li>
      <li>🍃 Inhale for 4 seconds, hold for 4, exhale for 4</li>
      <li>🍃 Let thoughts pass like clouds in the sky</li>
    </ul>
  </div>

  <footer>
    🌱 Breathe deeply, live gently 🌱<br>
    Crafted with calm by your inner nature
  </footer>

  <!-- YouTube Iframe API for play/pause control -->
  <script src="https://www.youtube.com/iframe_api"></script>
  <script>
    let player;
    function onYouTubeIframeAPIReady() {
      player = new YT.Player('yt-audio');
    }

    function playAudio() {
      if (player) player.playVideo();
    }

    function pauseAudio() {
      if (player) player.pauseVideo();
    }
  </script>
</body>
</html>
