<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mood Tracker - Serenity</title>
  <script src="https://cdn.tailwindcss.com/3.4.16"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#4CAF50',
            secondary: '#8E9AAF'
          },
          borderRadius: {
            'none': '0px',
            'sm': '4px',
            DEFAULT: '8px',
            'md': '12px',
            'lg': '16px',
            'xl': '20px',
            '2xl': '24px',
            '3xl': '32px',
            'full': '9999px',
            'button': '8px'
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #f9fafb;
    }
    .mood-card {
      transition: all 0.3s ease;
    }
    .mood-card:hover {
      transform: translateY(-2px);
    }
    input[type="radio"] {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }
    input[type="radio"]+label {
      cursor: pointer;
      transition: all 0.2s ease;
    }
    input[type="radio"]:checked+label {
      border-color: #4CAF50;
      background-color: rgba(76, 175, 80, 0.1);
    }
   
  @keyframes grow {
    0% { transform: scale(0); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .animate-grow {
    animation: grow 0.6s ease-out forwards;
  }
</style>
</head>
<body class="min-h-screen flex flex-col items-center bg-green-100 font-sans">
  <%- include('navbar') %>
  <main class="container">
    <section class="text-center mb-12">
      <h1 class="text-5xl font-serif text-gray-700 mb-4">Mood Tracker</h1>
      <p class="text-gray-600 max-w-2xl mx-auto">Select your mood to receive an uplifting quote</p>
    </section>

    <section class="max-w-3xl mx-auto bg-white rounded-lg shadow-sm p-8 mb-12">
      <h2 class="text-2xl font-serif text-gray-800 mb-8 text-center">How are you feeling today?</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="mood-card">
          <input type="radio" name="mood" id="happy" value="happy">
          <label for="happy" class="flex flex-col items-center justify-center p-4 border-2 border-yellow-200 rounded-full bg-yellow-50 hover:bg-yellow-100 transition-colors">
            <div class="w-10 h-10 flex items-center justify-center text-yellow-500 mb-2">
              <i class="ri-sun-line ri-xl"></i>
            </div>
            <span class="text-gray-700">Happy</span>
          </label>
        </div>
        <div class="mood-card">
          <input type="radio" name="mood" id="relaxed" value="relaxed">
          <label for="relaxed" class="flex flex-col items-center justify-center p-4 border-2 border-green-200 rounded-full bg-green-50 hover:bg-green-100 transition-colors">
            <div class="w-10 h-10 flex items-center justify-center text-green-500 mb-2">
              <i class="ri-mental-health-line ri-xl"></i>
            </div>
            <span class="text-gray-700">Relaxed</span>
          </label>
        </div>
        <div class="mood-card">
          <input type="radio" name="mood" id="energetic" value="energetic">
          <label for="energetic" class="flex flex-col items-center justify-center p-4 border-2 border-red-200 rounded-full bg-red-50 hover:bg-red-100 transition-colors">
            <div class="w-10 h-10 flex items-center justify-center text-red-500 mb-2">
              <i class="ri-flashlight-line ri-xl"></i>
            </div>
            <span class="text-gray-700">Energetic</span>
          </label>
        </div>
        <div class="mood-card">
          <input type="radio" name="mood" id="melancholy" value="melancholy">
          <label for="melancholy" class="flex flex-col items-center justify-center p-4 border-2 border-blue-200 rounded-full bg-blue-50 hover:bg-blue-100 transition-colors">
            <div class="w-10 h-10 flex items-center justify-center text-blue-500 mb-2">
              <i class="ri-moon-clear-line ri-xl"></i>
            </div>
            <span class="text-gray-700">Melancholy</span>
          </label>
        </div>
      </div>
    </section>
    </div>
    <section class="max-w-2xl mx-auto my-8 bg-white p-6 rounded-xl shadow">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Talk to Your Emotional Companion</h2>
      <div id="chatWindow" class="bg-gray-50 p-4 h-80 overflow-y-auto rounded border border-gray-200 mb-4 space-y-4"></div>
      <div class="flex items-center gap-3">
        <input id="chatInput" type="text" placeholder="Share your thoughts..." class="flex-1 px-4 py-2 border rounded-md" />
        <button onclick="sendMessage()" class="px-4 py-2 bg-green-500 text-white rounded-md">Send</button>
      </div>
    </section>
    <section id="moodGarden" class="max-w-2xl mx-auto bg-white mt-6 p-4 rounded-xl shadow text-center">
      <h2 class="text-xl font-semibold text-gray-800 mb-2">Your Mood Garden</h2>
      <button id="clearGarden" class="mb-4 px-4 py-2 text-sm bg-red-100 hover:bg-red-200 text-red-700 rounded">🗑️ Clear Garden</button>
      <div id="gardenPlot" class="grid grid-cols-4 gap-4 p-4 min-h-[100px] bg-green-50 rounded">
        <!-- Mood icons with dates will appear here -->
      </div>
    </section>
   <!-- Perfectly Centered & Contained Quote Card -->
<!-- Clean Centered Square-like Quote Card -->
<div id="quoteCard"
     class="hidden fixed inset-0 z-50 flex items-center justify-center pointer-events-none">
  <div class="bg-yellow-100 text-yellow-900 px-8 py-8 rounded-6xl shadow-6xl
              text-center text-base animate-fadeIn font-semibold max-w-xs w-full max-h-50
              overflow-hidden pointer-events-auto flex items-center justify-center">
    <!-- Quote text will go here via JS -->
  </div>
</div>
    <style>
    @keyframes fadeInOut {
  0% { opacity: 0; transform: scale(0.95); }
  10% { opacity: 1; transform: scale(1); }
  90% { opacity: 1; }
  100% { opacity: 0; transform: scale(0.95); }
}
.animate-fadeIn {
  animation: fadeInOut 3s ease-in-out;
}
    </style>
    
    <script>
      const moodEmojis = {
        happy: "🌼",
        relaxed: "🌳",
        energetic: "☀️",
        melancholy: "🌧️"
      };
    
      function updateGarden(mood) {
        const icon = moodEmojis[mood];
        if (!icon) return;
    
        fetch('/api/add-mood-garden', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mood, icon })
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            const wrapper = document.createElement('div');
            wrapper.className = "flex flex-col items-center text-sm animate-bounce";
            wrapper.innerHTML = `<span class="text-2xl">${data.icon}</span><span class="text-gray-600">${data.date}</span>`;
            document.getElementById('gardenPlot').appendChild(wrapper);
    
            const saved = JSON.parse(localStorage.getItem('moodGarden')) || [];
            saved.push({ icon: data.icon, date: data.date });
            localStorage.setItem('moodGarden', JSON.stringify(saved));
    
            setTimeout(() => wrapper.classList.remove('animate-bounce'), 1000);
          }
        });
      }
    
      function showQuoteCard(quote) {
  const cardWrapper = document.getElementById('quoteCard');
  const card = cardWrapper.querySelector('div');
  card.textContent = quote;

  cardWrapper.classList.remove('hidden');
  card.classList.add('animate-fadeIn');

  setTimeout(() => {
    cardWrapper.classList.add('hidden');
    card.classList.remove('animate-fadeIn');
  }, 6000);
}

    
      async function getDailyQuote() {
  const today = new Date().toLocaleDateString();
  const stored = JSON.parse(localStorage.getItem('dailyQuote'));

  if (stored && stored.date === today) {
    showQuoteCard(stored.quote);
    return;
  }

  const res = await fetch("/api/daily-quote");
  const data = await res.json();
  const quote = data?.quote || "You're doing great, even if it's quiet progress.";
if (quote.length > 120) {
  quote = quote.slice(0, 110).trim() + "...";
}
quote = "🌟 " + quote.trim() + " 🌟";

  showQuoteCard(quote);
  localStorage.setItem('dailyQuote', JSON.stringify({ quote, date: today }));
}
    
      document.addEventListener('DOMContentLoaded', function () {
        getDailyQuote();
    
        const savedGarden = JSON.parse(localStorage.getItem('moodGarden')) || [];
        const garden = document.getElementById('gardenPlot');
        savedGarden.forEach(({ icon, date }) => {
          const wrapper = document.createElement('div');
          wrapper.className = "flex flex-col items-center text-sm";
          wrapper.innerHTML = `<span class="text-2xl">${icon}</span><span class="text-gray-600">${date}</span>`;
          garden.appendChild(wrapper);
        });
    
        document.getElementById('clearGarden').addEventListener('click', () => {
          localStorage.removeItem('moodGarden');
          garden.innerHTML = '';
        });
    
        const moodCards = document.querySelectorAll('.mood-card input');
        moodCards.forEach(card => {
          card.addEventListener('change', () => {
            updateGarden(card.value);
          });
        });
      });
    </script>
</body>
</html>    
  
