<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit My Account - Nature Vibes</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-green-50 font-sans text-gray-800" style="background-image: url('/images/bg-nature.jpg'); background-size: cover;">
  <%- include('navbar') %>

  <div class="max-w-xl mx-auto mt-20 bg-white/80 p-8 rounded-xl shadow">
    <h2 class="text-2xl font-bold text-green-800 mb-6 text-center">✏️ Edit Your Account</h2>
    
    <form method="POST" action="/profile/edit" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block mb-1 font-medium">Username</label>
        <input name="username" type="text" required value="<%= user.username %>" class="w-full p-2 rounded border border-gray-300 focus:ring-green-400 focus:border-green-400">
      </div>

      <div>
        <label class="block mb-1 font-medium">Email</label>
        <input name="email" type="email" required value="<%= user.email %>" class="w-full p-2 rounded border border-gray-300 focus:ring-green-400 focus:border-green-400">
      </div>

      <div>
        <label class="block mb-1 font-medium">New Password</label>
        <input name="password" type="password" placeholder="Leave blank to keep current" class="w-full p-2 rounded border border-gray-300">
        <p class="text-sm text-gray-500">Minimum 6 characters</p>
      </div>

      <div>
        <label class="block mb-1 font-medium">Profile Image</label>
        <input type="file" name="profileImage" accept="image/*" class="w-full text-sm text-gray-700">
      </div>

      <div class="flex justify-center gap-4 mt-6">
        <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-6 py-2 rounded shadow">Save Changes</button>
        <a href="/profile/account" class="text-gray-600 hover:underline">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
