<!DOCTYPE html>
<html lang="en">
<head>
  <title>Forgot Password</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center min-h-screen font-sans">
  <div class="bg-white rounded-xl shadow-xl p-8 max-w-md w-full animate-fade-in">
    <h2 class="text-2xl font-bold text-green-700 mb-6 text-center">Forgot Your Password?</h2>
    <form action="/forgot-password" method="POST" class="space-y-4">
      <input type="email" name="email" required placeholder="Enter your registered email"
             class="w-full px-4 py-3 border border-green-300 rounded-lg focus:ring-2 focus:ring-green-400 outline-none"/>
      <button type="submit"
              class="w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-lg font-semibold transition duration-300">
        Send OTP
      </button>
      <% if (typeof error !== 'undefined') { %>
        <p class="text-red-600 text-center"><%= error %></p>
      <% } %>
    </form>
  </div>
</body>
</html>
