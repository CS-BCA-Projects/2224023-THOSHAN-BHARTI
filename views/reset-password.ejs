<!DOCTYPE html>
<html lang="en">
<head>
  <title>Reset Password</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center min-h-screen font-sans">
  <div class="bg-white rounded-xl shadow-xl p-8 max-w-md w-full animate-fade-in">
    <h2 class="text-2xl font-bold text-blue-700 mb-6 text-center">Reset Your Password</h2>
    <form action="/reset-password" method="POST" class="space-y-4">
      <input type="password" name="password" required placeholder="New password"
             class="w-full px-4 py-3 border border-blue-300 rounded-lg focus:ring-2 focus:ring-blue-400 outline-none"/>
      <button type="submit"
              class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-semibold transition duration-300">
        Reset Password
      </button>
    </form>
  </div>
</body>
</html>
