<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard - Healing with Music</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Arial', sans-serif;
      color: #333;
      background: linear-gradient(to bottom, #ffccf9, #ffe6f2, #ffffff);
      min-height: 100vh;
    }
    .admin-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
    }
    .navbar {
      background-color: #ff99cc;
      width: 100%;
      padding: 15px;
      text-align: center;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
    }
    .navbar a {
      color: #fff;
      margin: 0 15px;
      text-decoration: none;
      font-weight: bold;
    }
    .content-section {
      background-color: #ffffff;
      border: 2px solid #ffb3d9;
      border-radius: 15px;
      padding: 20px;
      width: 90%;
      max-width: 600px;
      margin-bottom: 20px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }
    h2 {
      color: #ff66b2;
      text-align: center;
    }
    .input-field {
      width: 100%;
      padding: 10px;
      margin-top: 8px;
      border: 2px solid #ffb3d9;
      border-radius: 12px;
    }
    .btn-primary {
      background-color: #ff66b2;
      color: #fff;
      border: none;
      border-radius: 20px;
      padding: 10px 20px;
      cursor: pointer;
      transition: background 0.3s ease;
      display: block;
      width: 100%;
      margin-top: 10px;
      font-size: 16px;
    }
    .btn-primary:hover {
      background-color: #ff3385;
    }
    .user-list, .sound-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .user-list li, .sound-list li {
      background: #fff;
      padding: 12px;
      border-radius: 10px;
      margin: 10px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border: 1px solid #1a6940;
      box-shadow: 2px 2px 6px rgba(0, 0, 0, 0.1);
    }
    .delete-btn {
      background: #198053;
      color: white;
      border: none;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s ease;
    }
    .delete-btn:hover {
      background: #065120;
    }
  </style>
</head>

<body>
<%- include('navbar') %>

<div class="admin-container">
  <section class="content-section">
    <h2>Manage Users</h2>
    <ul id="user-list" class="user-list"></ul>
  </section>
</div>

<script>
  async function fetchUsers() {
    const response = await fetch('/admin/users');
    const users = await response.json();
    const userList = document.getElementById('user-list');
    userList.innerHTML = users.map(user => `
      <li>
        <span>${user.email}</span>
        <button onclick="deleteUser('${user._id}')" class="delete-btn">Delete</button>
      </li>`).join('');
  }

  async function deleteUser(userId) {
    await fetch(`/admin/delete-user/${userId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    fetchUsers();
  }
  fetchUsers();

</script>
</body>
</html>
