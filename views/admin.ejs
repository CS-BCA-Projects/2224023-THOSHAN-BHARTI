<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Panel - Nature Vibes</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-green-100 font-sans" style="background-image: url('/images/bg-nature.jpg'); background-size: cover; background-position: center; background-attachment: fixed;">

  <!-- Include updated shared navbar -->
  <%- include('navbar') %>

  <div class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-green-900 text-center mb-6">Admin Dashboard</h1>

    <!-- Example admin content -->
    <div class="bg-white/80 p-6 rounded-xl shadow-lg">
      <h2 class="text-xl font-semibold text-green-800 mb-4">Manage Playlists</h2>
      <p class="text-green-700">You can add, update or delete playlists from here.</p>
    </div>

    <!-- Additional Admin Section -->
    <div class="mt-8 bg-white/80 p-6 rounded-xl shadow-lg">
      <h2 class="text-xl font-semibold text-green-800 mb-4">User Management</h2>
      <p class="text-green-700">Control user access and monitor activity.</p>
    </div>
  </div>

  <footer class="text-center text-green-800 py-6">
    <p>🌿 Nature Vibes Admin Panel</p>
  </footer>

</body>
</html>
