<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sign Up Page</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Arial', sans-serif;
      color: #333;
      background: url('https://images.unsplash.com/photo-1523978591478-c753949ff840?auto=format&fit=crop&w=1950&q=80') no-repeat center center fixed;
      background-size: cover;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }

    .container {
      background: rgba(255, 255, 255, 0.9);
      border-radius: 20px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
      padding: 20px;
      width: 90%;
      max-width: 600px;
      margin-top: 40px;
      backdrop-filter: blur(5px);
    }

    header {
      background: #66cc66;
      padding: 15px;
      color: white;
      text-align: center;
      border-radius: 20px 20px 0 0;
    }

    .nav-links {
      list-style: none;
      padding: 0;
      margin: 10px 0;
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .nav-links a {
      color: #fff;
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 8px;
      background-color: #66cc66;
      transition: background 0.3s ease;
    }

    .nav-links a:hover {
      background-color: #4CAF50;
    }

    input[type=text],
    input[type=password],
    input[type=number],
    textarea {
      width: 100%;
      padding: 12px;
      margin: 8px 0 20px 0;
      border: 2px solid #b3ffb3;
      border-radius: 10px;
      background: #f9fff9;
    }

    input[type=text]:focus,
    input[type=password]:focus,
    input[type=number]:focus,
    textarea:focus {
      background-color: #f0fff0;
      outline: none;
    }

    .registerbtn {
      background-color: #66cc66;
      color: white;
      padding: 16px 20px;
      margin: 10px 0;
      border: none;
      cursor: pointer;
      width: 100%;
      border-radius: 20px;
      font-size: 16px;
    }

    .registerbtn:hover {
      background-color: #4CAF50;
    }

    .signin {
      background-color: #f1f1f1;
      text-align: center;
      padding: 10px;
      border-radius: 0 0 20px 20px;
    }

    .signin a {
      color: #4CAF50;
      font-weight: bold;
      text-decoration: none;
    }

    .signin a:hover {
      text-decoration: underline;
    }

    label {
      font-weight: bold;
    }

    h2 {
      margin-top: 15px;
      color: #4e944f;
    }

    hr {
      border: 0;
      height: 1px;
      background: #c8e6c9;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Sign Up</h1>
      <nav>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/playlist">Playlists</a></li>
          <li><a href="/login">Login</a></li>
          <li><a href="/signup">Signup</a></li>
          <li><a href="/forum">Forum</a></li>
        </ul>
      </nav>
    </header>

    <form action="/signup" method="POST" id="signupForm">
      <h2>Create Your Account</h2>
      <hr>

      <label>Username:</label>
      <input type="text" name="username" placeholder="Enter username" required>

      <label>Email:</label>
      <input type="text" name="email" placeholder="Enter email" required>

      <label>Password:</label>
      <input type="password" name="password" placeholder="Enter password" required>

      <label>Confirm Password:</label>
      <input type="password" name="cnfPassword" placeholder="Confirm password" required>

      <label>Age:</label>
      <input type="number" name="age" placeholder="Enter your age" min="1" required>

      <label>Emotional Issue:</label>
      <textarea name="emotionalIssue" rows="3" placeholder="Briefly describe what you're going through" required></textarea>

      <button type="submit" class="registerbtn">Register</button>
    </form>

    <div class="signin">
      <p>Already have an account? <a href="/login">Login here</a></p>
    </div>
  </div>

  <script>
    document.getElementById('signupForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData.entries());

      if (!data.username || !data.email || !data.password || !data.cnfPassword || !data.age || !data.emotionalIssue) {
        alert('All fields are required!');
        return;
      }

      if (data.password !== data.cnfPassword) {
        alert('Passwords do not match!');
        return;
      }

      try {
        const response = await fetch('/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: data.username,
            email: data.email,
            password: data.password,
            age: data.age,
            emotionalIssue: data.emotionalIssue
          })
        });

        const result = await response.json();

        if (result.success) {
          alert(result.message);
          window.location.href = result.redirectUrl;
        } else {
          alert(result.message);
        }
      } catch (err) {
        console.error('Signup Error:', err);
        alert('Something went wrong!');
      }
    });
  </script>
</body>
</html>
