<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Navbar - Serenity</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body class="bg-gradient-to-b from-sky-100/40 to-transparent min-h-screen">

  <!-- Navbar -->
  <nav class="w-full fixed top-0 left-0 z-50 bg-white/10 backdrop-blur-md shadow-sm px-6 py-3">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      
      <!-- Logo -->
      <div class="flex items-center gap-2 text-white font-bold text-xl">
        <i class="ph ph-music-note-simple text-green-400"></i>
        <span class="font-[Pacifico] text-black">Serenity</span>
      </div>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex gap-8 text-black font-medium">
        <li><a href="/" class="hover:text-green-400">Home</a></li>
        <li><a href="/playlist" class="hover:text-green-400">Music</a></li>
        <li><a href="/relax" class="hover:text-green-400">Relax Activities</a></li>
        <li><a href="/moodTracker" class="hover:text-green-400">Mood Tracker</a></li>
      </ul>

      <!-- Right Side (Profile or Auth) -->
      <div class="hidden md:flex items-center gap-4 text-black relative">
        <% if (user) { %>
          <!-- Profile Dropdown -->
          <div class="relative">
            <button id="profileBtn" class="flex items-center gap-2 focus:outline-none hover:text-green-400">
              <i class="ph ph-user-circle text-2xl"></i>
              <i class="ph ph-caret-down text-sm"></i>
            </button>

            <div id="profileDropdown" class="hidden absolute right-0 mt-2 w-48 bg-white text-gray-800 rounded shadow-lg py-2 z-50">
              <a href="/profile/account" class="block px-4 py-2 hover:bg-green-100">👤 My Account</a>
              <a href="/profile/edit" class="block px-4 py-2 hover:bg-green-100">✏️ Edit Account</a>
              <a href="/admin" class="block px-4 py-2 hover:bg-green-100">🛠️ Admin Page</a>
              <a href="/logout" class="block px-4 py-2 hover:bg-red-100 text-red-600">🚪 Logout</a>
            </div>
          </div>

          <a href="/library" class="hover:text-green-400">📚 My Library</a>
        <% } else { %>
          <a href="/login" class="flex items-center gap-1 px-3 py-1.5 hover:text-green-400 transition">
            <i class="ph ph-sign-in"></i> Login
          </a>
          <a href="/signup" class="flex items-center gap-1 px-3 py-1.5 hover:text-green-400 transition bg-white/10 backdrop-blur rounded-lg">
            <i class="ph ph-user-plus"></i> Signup
          </a>
        <% } %>
      </div>

      <!-- Mobile Menu Toggle -->
      <button id="menu-toggle" class="md:hidden text-white text-2xl focus:outline-none">
        <i class="ph ph-list"></i>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="md:hidden mt-4 hidden flex-col gap-4 text-black font-medium px-4">
      <a href="/" class="hover:text-green-400 block">Home</a>
      <a href="/playlist" class="hover:text-green-400 block">Music</a>
      <a href="/relax" class="hover:text-green-400 block">Relax Activities</a>
      <a href="/moodTracker" class="hover:text-green-400 block">Mood Tracker</a>

      <% if (user) { %>
        <a href="/profile/account" class="hover:text-green-400 block">👤 My Account</a>
        <a href="/profile/edit" class="hover:text-green-400 block">✏️ Edit Account</a>
        <a href="/admin" class="hover:text-green-400 block">🛠️ Admin</a>
        <a href="/library" class="hover:text-green-400 block">📚 My Library</a>
        <a href="/logout" class="hover:text-red-400 block">🚪 Logout</a>
      <% } else { %>
        <a href="/login" class="hover:text-green-400 block">Login</a>
        <a href="/signup" class="hover:text-green-400 block">Signup</a>
      <% } %>
    </div>
  </nav>

  <!-- Push page content below navbar -->
  <div class="pt-20"></div>

  <!-- JS -->
  <script>
    // Mobile menu toggle
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");

    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });

    // Profile dropdown toggle
    const profileBtn = document.getElementById("profileBtn");
    const profileDropdown = document.getElementById("profileDropdown");

    document.addEventListener("click", (e) => {
      if (!profileBtn || !profileDropdown) return;

      const isClickInside = profileBtn.contains(e.target) || profileDropdown.contains(e.target);
      if (!isClickInside) {
        profileDropdown.classList.add("hidden");
      } else {
        profileDropdown.classList.toggle("hidden");
      }
    });
  </script>
</body>
</html>
