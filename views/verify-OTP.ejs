<!DOCTYPE html>
<html lang="en">
<head>
  <title>Verify OTP</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-pink-100 to-pink-200 flex items-center justify-center min-h-screen font-sans">
  <div class="bg-white rounded-xl shadow-xl p-8 max-w-md w-full animate-fade-in">
    <h2 class="text-2xl font-bold text-pink-700 mb-6 text-center">Enter OTP</h2>

    <form action="/verify-otp" method="POST" class="space-y-4">
      <input
        type="text"
        name="otp"
        maxlength="6"
        required
        placeholder="Enter 6-digit OTP"
        class="w-full px-4 py-3 border border-pink-300 rounded-lg focus:ring-2 focus:ring-pink-400 outline-none"
      />

      <button
        type="submit"
        class="w-full bg-pink-600 hover:bg-pink-700 text-white py-3 rounded-lg font-semibold transition duration-300"
      >
        Verify
      </button>

      <% if (typeof error !== 'undefined') { %>
        <p class="text-red-600 text-center mt-2"><%= error %></p>

        <% if (typeof expired !== 'undefined' && expired) { %>
          <div class="text-center mt-4">
            <a href="/forgot-password" class="text-pink-600 hover:underline font-semibold">
              Resend OTP
            </a>
          </div>
        <% } %>
      <% } %>
    </form>
  </div>
</body>
</html>
